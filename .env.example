# MongoDB connection string (MongoDB Atlas recommended).
# Include the database name in the path, e.g. .../tvrandomizer?retryWrites=true
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/tvrandomizer?retryWrites=true&w=majority

# Optional: database name override (used if not present in the URI path)
# MONGODB_DB=tvrandomizer

# Optional: local server port (default 7001)
# PORT=7001
